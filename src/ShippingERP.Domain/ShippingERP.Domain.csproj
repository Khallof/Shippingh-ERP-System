<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain layer: the heart of the system.
    It must NOT reference other projects, EF Core or ASP.NET Core.

    One deliberate exception: Microsoft.Extensions.Identity.Stores. It only contains the plain
    IdentityUser / IdentityRole base classes (no database, no web code), so ApplicationUser and
    ApplicationRole can live here next to the other entities.
  -->
  <PropertyGroup>
    <RootNamespace>ShippingERP.Domain</RootNamespace>
    <AssemblyName>ShippingERP.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="8.0.11" />
  </ItemGroup>

</Project>
