<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure layer: EF Core, SQL Server, ASP.NET Core Identity stores, JWT creation, seeding,
    external services (SMS, email, files...). It implements the interfaces defined in Application.
  -->
  <PropertyGroup>
    <RootNamespace>ShippingERP.Infrastructure</RootNamespace>
    <AssemblyName>ShippingERP.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <!-- Same Microsoft.IdentityModel version (8.23.0) as the API project pins for JwtBearer 10. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- Microsoft.Data.SqlClient (EF Core SqlServer 10) brings System.Security.Cryptography.Pkcs 9.0.11, which has known
         vulnerabilities (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). Pin the serviced .NET 10 version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!--
    Step 4 (shipments):
    - ClosedXML (MIT): read / write Excel files for the shipment import.
    - QuestPDF (Community MIT license for companies under USD 1M revenue, commercial license otherwise): label PDFs.
    - ZXing.Net (Apache-2.0): Code 128 barcodes and QR codes as SVG.
  -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="QuestPDF" Version="2025.12.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <!-- Cairo font (SIL Open Font License, see Fonts/OFL.txt): Arabic + Latin on labels, even in Docker without fonts. -->
  <ItemGroup>
    <EmbeddedResource Include="Shipments\Labels\Fonts\*.ttf" />
    <None Include="Shipments\Labels\Fonts\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShippingERP.Application\ShippingERP.Application.csproj" />
  </ItemGroup>

</Project>
